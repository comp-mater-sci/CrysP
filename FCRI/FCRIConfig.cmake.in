#  Config file for the @PROJECT_NAME@ package
#  It defines the following variables:
#  <project_name>_INCLUDE_DIR - include directory 
#  <project_name>_LIBRARY_DIR - directory where the libraries can be found
#  <project_name>_LIBRARIES    - libraries to link against

@PACKAGE_INIT@

message("@PROJECT_NAME@ package location: ${PACKAGE_PREFIX_DIR}")

set_and_check(FCRI_INCLUDE_DIR "@PACKAGE_FCRI_INCLUDE_DIR@")
set_and_check(FCRI_LIBRARY_DIR "@PACKAGE_FCRI_LIBRARY_DIR@")

# Our library dependencies (contains definitions for IMPORTED targets)
include("${FCRI_DIR}/cmake/FCRITargets.cmake")

set(FCRI_LIBRARIES CRI)

set(FCRI_INCLUDE_DIRS ${FCRI_INCLUDE_DIR} ${FCRI_INCLUDE_DIR}/fcri)

